        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SETAS                                                        -->
        <!--                                                              -->
        <!-- Regra de waypoints:                                          -->
        <!--   - Todas as setas usam edgeStyle=elbowEdgeStyle ou          -->
        <!--     orthogonalEdgeStyle com waypoints explícitos             -->
        <!--   - Nenhuma seta cruza o interior de uma subnet/SG           -->
        <!--   - A seta EC2→RDS passa pelo corredor y=780 (abaixo dos SGs)-->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <!-- Seta 1: User → Internet (horizontal, y=112) -->
        <mxCell id="a-user-inet"
          value=""
          style="edgeStyle=orthogonalEdgeStyle;html=1;
                 strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=6 3;
                 endArrow=block;endFill=1;startArrow=none;
                 exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
          edge="1" source="user" target="internet" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Seta 2: Internet → IGW (horizontal, y=112) -->
        <mxCell id="a-inet-igw"
          value=""
          style="edgeStyle=orthogonalEdgeStyle;html=1;
                 strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=6 3;
                 endArrow=block;endFill=1;startArrow=none;
                 exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
          edge="1" source="internet" target="igw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Seta 3: IGW → EC2
             Saída: fundo do IGW (cx=794, y=144)
             Waypoint: x=1075, y=220  (canto sup direito da subnet pública, acima da subnet)
             Entrada: topo do EC2 (cx=1075, y=420)
             Trajeto: desce pelo lado direito, fora das bordas da VPC até entrar pela subnet -->
        <mxCell id="a-igw-ec2"
          value="HTTP  ·  Porta 5000"
          style="edgeStyle=orthogonalEdgeStyle;html=1;
                 strokeColor=#1D8348;strokeWidth=2;dashed=0;
                 endArrow=block;endFill=1;startArrow=none;
                 fontStyle=1;fontSize=11;fontColor=#1D8348;
                 exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          edge="1" source="igw" target="ec2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="794" y="200" />
              <mxPoint x="1075" y="200" />
              <mxPoint x="1075" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Seta 4: EC2 → RDS
             Saída: lado esquerdo do EC2  (x=1039, cy=456)
             Waypoint A: x=660, y=456  (corredor entre as duas subnets)
             Entrada: lado direito do RDS (x=436, cy=456)
             Trajeto: sai pela esquerda do EC2, vai pelo corredor central (x=660)
             e entra pelo lado direito do RDS, sem cruzar nenhuma subnet -->
        <mxCell id="a-ec2-rds"
          value="PostgreSQL  ·  TCP 5432"
          style="edgeStyle=orthogonalEdgeStyle;html=1;
                 strokeColor=#1A5276;strokeWidth=2;dashed=0;
                 endArrow=block;endFill=1;startArrow=none;
                 fontStyle=1;fontSize=11;fontColor=#1A5276;
                 exitX=0;exitY=0.5;entryX=1;entryY=0.5;"
          edge="1" source="ec2" target="rds" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="456" />
            </Array>
          </mxGeometry>
        </mxCell>

